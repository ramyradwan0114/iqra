# مفاتيح Firebase — انسخ الملف ده لـ .env.local واملا القيم
# على Vercel: Settings → Environment Variables
#
# المفاتيح دي مش أسرار (بتتشاف في كود المتصفح). الحماية الحقيقية لبيانات
# طلابك هي Firestore Security Rules — من غيرها أي حد يقدر يقرا ويمسح.
#
# طول ما القيم دي فاضية، التطبيق بيشتغل محليًا بالكامل (IndexedDB) ومابيلمسش
# السحابة أصلًا.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
